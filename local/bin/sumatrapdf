#!/bin/zsh
# This script is used to let the SumatraPDF open the pdf after path conversion
#
# https://github.com/lervag/vimtex/issues/2566 is the source see NeoVim
# :h vimtex-faq-sumatrapdf-wsl

new_arg=()                 # ceate arguments array
declare -i idxMntOccur=0

for arg ($@) {
  if [[ "$arg" == /* ]] {
    # convert to windows style path
    idxMntOccur=idxMntOccur+1
    winPath=$(wslpath -am $arg)
    new_arg+=$winPath

    if (($idxMntOccur == 1)) {
      # convert the paths in .synctex.gz to windows style using wslpath,
      # so it works regardless of the WSL mount point (e.g. /mnt/c vs /c)
      # run only once, when the first absolute path arg is detected
      find ${PWD} -maxdepth 1 -name "*.synctex.gz" -execdir \
        bash -c '
          cat "{}" | gunzip | while IFS= read -r line; do
            case "$line" in
              Input:*)
                rest=${line#Input:}
                tag=${rest%%:*}
                path=${rest#*:}
                printf "Input:%s:%s\n" "$tag" "$(wslpath -am "$path")"
                ;;
              *)
                printf "%s\n" "$line"
                ;;
            esac
          done | gzip > "{}.tmp" && mv "{}.tmp" "{}"
        ' \;
    }
  } else {
    new_arg+=$arg
  }
}

$LOCALAPPDATA/SumatraPDF/SumatraPDF.exe $new_arg &
